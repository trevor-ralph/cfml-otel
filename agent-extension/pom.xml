<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- io.github.trevor-ralph: the Maven Central namespace verified for this GitHub account -->
  <groupId>io.github.trevor-ralph</groupId>
  <artifactId>cfml-otel-agent-extension</artifactId>
  <version>0.3.4</version>
  <packaging>jar</packaging>
  <name>cfml-otel agent extension</name>
  <description>OpenTelemetry javaagent extension: identifies the database behind Adobe ColdFusion's built-in
    (macromedia / DataDirect) JDBC drivers. Loaded with -Dotel.javaagent.extensions=.</description>
  <url>https://github.com/trevor-ralph/cfml-otel</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>trevor-ralph</id>
      <name>Trevor Ralph</name>
      <url>https://github.com/trevor-ralph</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/trevor-ralph/cfml-otel.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/trevor-ralph/cfml-otel.git</developerConnection>
    <url>https://github.com/trevor-ralph/cfml-otel</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/trevor-ralph/cfml-otel/issues</url>
  </issueManagement>

  <properties>
    <!-- Reproducible build (see java/pom.xml) -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <!-- The javaagent this extension is built and tested against: build.sh AGENT_VERSION
         (tests/check-versions.sh). It reaches agent internals by name, so it is versioned with the agent. -->
    <otel.instrumentation.version>2.34.0</otel.instrumentation.version>
    <!-- 8, not the bridge's 11: the advice is copied into the drivers' own (Java 8) class files, where code
         from a newer javac (invokedynamic string concatenation) isn't valid -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Provided by the javaagent at runtime -->
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent-extension-api</artifactId>
      <version>${otel.instrumentation.version}-alpha</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
    <!-- Tests only: the agent's JDBC URL parser, to check the rewritten URLs parse as expected -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-jdbc</artifactId>
      <version>${otel.instrumentation.version}-alpha</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cfml-otel-agent-extension</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Maven Central (dev/maven-central-publish.sh, run by release.yml): sources and javadoc jars, signatures, upload.
         Keep in step with java/pom.xml's copy. -->
    <profile>
      <id>central</id>
      <properties>
        <central.skipUpload>false</central.skipUpload>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Bouncy Castle signer: the key comes from MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE, no gpg install -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <skipUpload>${central.skipUpload}</skipUpload>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
