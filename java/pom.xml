<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- io.github.trevor-ralph: the Maven Central namespace verified for this GitHub account -->
  <groupId>io.github.trevor-ralph</groupId>
  <artifactId>cfml-otel-bridge</artifactId>
  <version>0.3.4</version>
  <packaging>jar</packaging>
  <name>cfml-otel bridge</name>
  <description>Thin static bridge so CFML engines call the OpenTelemetry API through its public interfaces.</description>
  <url>https://github.com/trevor-ralph/cfml-otel</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>trevor-ralph</id>
      <name>Trevor Ralph</name>
      <url>https://github.com/trevor-ralph</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/trevor-ralph/cfml-otel.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/trevor-ralph/cfml-otel.git</developerConnection>
    <url>https://github.com/trevor-ralph/cfml-otel</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/trevor-ralph/cfml-otel/issues</url>
  </issueManagement>

  <properties>
    <!-- A fixed timestamp for the jar entries makes the build reproducible: the same commit built in the same image
         gives byte-identical jars, so the Maven Central upload can be checked against the release zip -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Keep at or below the OTel javaagent's bundled SDK version (agent 2.34.0 -> 1.68.0). -->
    <otel.api.version>1.68.0</otel.api.version>
    <!-- The SDK fallback's jars. Normally the API version; the CI min-API check compiles the bridge against an older
         API with this left at the build's version (see .github/workflows/ci.yml). -->
    <otel.sdk.version>${otel.api.version}</otel.sdk.version>
    <!-- opentelemetry-instrumentation-api, for otel.setRoute(): released with the javaagent, same version as build.sh
         AGENT_VERSION (tests/check-versions.sh). build.sh puts the jar in lib/. -->
    <otel.instrumentation.version>2.34.0</otel.instrumentation.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Provided: the module ships these jars in lib/ next to the bridge. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- otel.setRoute() (ServerRoute.java): the javaagent bridges this API's route updates to its SERVER span. Only
         the jar itself is needed at runtime (build.sh puts it in lib/); its incubator/semconv deps aren't. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-instrumentation-api</artifactId>
      <version>${otel.instrumentation.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>io.opentelemetry</groupId><artifactId>opentelemetry-api-incubator</artifactId></exclusion>
        <exclusion><groupId>io.opentelemetry.semconv</groupId><artifactId>opentelemetry-semconv</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- SDK fallback (opt-in, sdkFallback): copied to lib/sdk/ by build.sh, loaded only when an app adds it.
         No OkHttp/Kotlin and no JDK sender (ACF's Java runtime has no java.net.http): the bridge's own
         UrlConnectionHttpSender is the OTLP/HTTP sender. Same version as the API. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cfml-otel-bridge-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <!-- target/sdk/: the SDK fallback's jars (everything provided except the API jars lib/ already has) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>sdk-jars</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/sdk</outputDirectory>
              <includeScope>provided</includeScope>
              <excludeArtifactIds>opentelemetry-api,opentelemetry-context,opentelemetry-common,opentelemetry-instrumentation-api</excludeArtifactIds>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Maven Central (dev/maven-central-publish.sh, run by release.yml): sources and javadoc jars, signatures, upload.
         Keep in step with agent-extension/pom.xml's copy. -->
    <profile>
      <id>central</id>
      <properties>
        <central.skipUpload>false</central.skipUpload>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Bouncy Castle signer: the key comes from MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE, no gpg install -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <skipUpload>${central.skipUpload}</skipUpload>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
