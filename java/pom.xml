<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cfmlotel</groupId>
  <artifactId>cfml-otel-bridge</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <description>Thin static bridge so CFML engines call the OpenTelemetry API through its public interfaces.</description>

  <properties>
    <!-- Keep at or below the OTel javaagent's bundled SDK version (agent 2.33.1 -> 1.67.0). -->
    <otel.api.version>1.67.0</otel.api.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Provided: the module ships these jars in lib/ next to the bridge. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.api.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cfml-otel-bridge-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg></compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
