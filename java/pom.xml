<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cfmlotel</groupId>
  <artifactId>cfml-otel-bridge</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>
  <description>Thin static bridge so CFML engines call the OpenTelemetry API through its public interfaces.</description>

  <properties>
    <!-- Keep at or below the OTel javaagent's bundled SDK version (agent 2.33.1 -> 1.67.0). -->
    <otel.api.version>1.67.0</otel.api.version>
    <!-- The SDK fallback's jars. Normally the API version; the CI min-API check compiles the bridge against an older
         API with this left at the build's version (see .github/workflows/ci.yml). -->
    <otel.sdk.version>${otel.api.version}</otel.sdk.version>
    <!-- opentelemetry-instrumentation-api, for otel.setRoute(): released with the javaagent, same version as build.sh
         AGENT_VERSION (tests/check-versions.sh). build.sh puts the jar in lib/. -->
    <otel.instrumentation.version>2.33.1</otel.instrumentation.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Provided: the module ships these jars in lib/ next to the bridge. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- otel.setRoute() (ServerRoute.java): the javaagent bridges this API's route updates to its SERVER span. Only
         the jar itself is needed at runtime (build.sh puts it in lib/); its incubator/semconv deps aren't. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-instrumentation-api</artifactId>
      <version>${otel.instrumentation.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>io.opentelemetry</groupId><artifactId>opentelemetry-api-incubator</artifactId></exclusion>
        <exclusion><groupId>io.opentelemetry.semconv</groupId><artifactId>opentelemetry-semconv</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- SDK fallback (opt-in, sdkFallback): copied to lib/sdk/ by build.sh, loaded only when an app adds it.
         No OkHttp/Kotlin and no JDK sender (ACF's Java runtime has no java.net.http): the bridge's own
         UrlConnectionHttpSender is the OTLP/HTTP sender. Same version as the API. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cfml-otel-bridge-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <plugin>
        <!-- target/sdk/: the SDK fallback's jars (everything provided except the API jars lib/ already has) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>sdk-jars</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/sdk</outputDirectory>
              <includeScope>provided</includeScope>
              <excludeArtifactIds>opentelemetry-api,opentelemetry-context,opentelemetry-common,opentelemetry-instrumentation-api</excludeArtifactIds>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
